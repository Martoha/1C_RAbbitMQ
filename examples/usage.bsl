// ProgID: OneCRabbit.Client
// Аргументы COM передаются по позиции. Имена ниже — подписи для 1С.

Клиент = Новый COMОбъект("OneCRabbit.Client");

// --- подключение ---
ИмяПодключения = "1c";                     // SetConnectionName, до Connect. Видно в списке соединений RabbitMQ
КодировкаЧтения = "windows-1251";          // SetReadEncoding: utf-8 | windows-1251 | win1251 | cp1251
КодировкаЗаписи = "utf-8";                 // SetWriteEncoding: во что кодировать текст при Publish
Хост = "rabbit.example.com";               // Connect, 1
Порт = 5672;                               // Connect, 2
Пользователь = "guest";                    // Connect, 3
Пароль = "guest";                          // Connect, 4
ВиртуальныйХост = "/";                     // Connect, 5. Пустая строка тоже означает "/"

// --- очередь ---
ИмяОчереди = "orders";                     // уже существующая очередь
ТипОчереди = "quorum";                     // DeclareQueueType: classic | quorum | stream
ЧислоСообщений = 0;                        // SetPrefetch: 0 — все, максимум 65535
ТегПотребителя = "orders-1c";              // Subscribe, 2. Пустая строка — тег назначит RabbitMQ

// --- сообщение ---
МеткаДоставки = "";                        // приходит в Сообщение.DeliveryTag
ВернутьВОчередь = Истина;                  // Nack, 2. Истина — вернуть в ту же очередь, Ложь — снять
ОчередьНазначения = "archive";             // Move, 2
ТекстСообщения = "";                       // Publish, 2. Уйдёт в кодировке КодировкаЗаписи
Обменник = "";                             // PublishTo, 1. Пустая строка — обменник по умолчанию
КлючМаршрутизации = ИмяОчереди;            // PublishTo, 2

Попытка
    Клиент.SetConnectionName(ИмяПодключения);
    Клиент.SetReadEncoding(КодировкаЧтения);
    Клиент.SetWriteEncoding(КодировкаЗаписи);
    Клиент.Connect(Хост, Порт, Пользователь, Пароль, ВиртуальныйХост);

    // Очередь уже есть: только проверить, аргументы брокера не менять.
    Клиент.DeclareExisting(ИмяОчереди);
    // Новая очередь: Клиент.DeclareQueue(ИмяОчереди);
    // Новая quorum-очередь: Клиент.DeclareQueueType(ИмяОчереди, ТипОчереди);

    Клиент.SetPrefetch(ЧислоСообщений);
    ТегПотребителя = Клиент.Subscribe(ИмяОчереди, ТегПотребителя);

    Пока Истина Цикл
        Сообщение = Клиент.Receive();
        Если Не Сообщение.HasMessage Тогда
            Прервать;
        КонецЕсли;

        ТекстСообщения = Сообщение.Body;          // строка 1С, уже раскодированная
        МеткаДоставки = Сообщение.DeliveryTag;    // строка, её передавать в Ack, Nack и Move
        // Сообщение.ConsumerTag
        // Сообщение.Exchange
        // Сообщение.RoutingKey
        // Сообщение.Redelivered — Истина, если брокер прислал сообщение повторно

        Клиент.Ack(МеткаДоставки);
        // Клиент.Nack(МеткаДоставки, ВернутьВОчередь);
        // Клиент.Move(МеткаДоставки, ОчередьНазначения);
    КонецЦикла;

    Клиент.Unsubscribe();
    // Клиент.Publish(ИмяОчереди, ТекстСообщения);
    // Клиент.PublishTo(Обменник, КлючМаршрутизации, ТекстСообщения);
    // Клиент.GetMessage(ИмяОчереди); // одно сообщение и сразу подтверждение, без Ack
Исключение
    Сообщить(ОписаниеОшибки());
КонецПопытки;

Если Клиент.IsConnected() Тогда
    Клиент.Disconnect();
КонецЕсли;
