<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0;net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>OneCRabbit</RootNamespace>
    <AssemblyName>OneCRabbit</AssemblyName>
    <Net48Platform Condition="'$(Net48Platform)' == ''">x64</Net48Platform>
    <PlatformTarget Condition="'$(TargetFramework)' == 'net48'">$(Net48Platform)</PlatformTarget>
    <Version>1.0.0</Version>
    <ComVisible>false</ComVisible>
    <SignAssembly Condition="Exists('$(MSBuildThisFileDirectory)OneCRabbit.snk')">true</SignAssembly>
    <AssemblyOriginatorKeyFile Condition="Exists('$(MSBuildThisFileDirectory)OneCRabbit.snk')">OneCRabbit.snk</AssemblyOriginatorKeyFile>
    <Description>COM-прослойка RabbitMQ для 1С</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\net48-$(Net48Platform)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\net48-$(Net48Platform)\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>OneCRabbit.Tests, </_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RabbitMQ.Client" Version="6.8.1" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <Target Name="CopyToDist" AfterTargets="Build" Condition="'$(TargetFramework)' == 'net48' and '$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_DistDir>$(MSBuildThisFileDirectory)..\..\dist\</_DistDir>
      <_DistDir Condition="'$(PlatformTarget)' == 'x86'">$(MSBuildThisFileDirectory)..\..\dist\x86\</_DistDir>
      <_RegisterScript>register-com.ps1</_RegisterScript>
      <_RegisterScript Condition="'$(PlatformTarget)' == 'x86'">register-com-x86.ps1</_RegisterScript>
    </PropertyGroup>
    <ItemGroup>
      <_DistDll Include="$(TargetDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_DistDll)" DestinationFolder="$(_DistDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\scripts\$(_RegisterScript)" DestinationFiles="$(_DistDir)register-com.ps1" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\examples\usage.bsl" DestinationFolder="$(_DistDir)" SkipUnchangedFiles="false" />
  </Target>
</Project>
